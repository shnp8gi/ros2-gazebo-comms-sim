<?xml version="1.0"?>
<model>
  <name>GhostBox</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    遮蔽車 (role: blocker) 用の非接触ボックス。SimpleBox から collision を
    除いたもの。確率交通流 (traffic_gen) では車線間・車間で物理形状が重なり
    得るため、接触ソルバに載せないことで RTF を保つ。
    遮蔽 OBB は model_catalog の blockage 属性が別途与える。
  </description>
</model>
