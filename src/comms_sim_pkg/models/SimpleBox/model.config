<?xml version="1.0"?>
<model>
  <name>SimpleBox</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    ヘッドレス評価用の軽量ボックス車両。SUVメッシュ+ホイール関節の接触計算を
    避けるための単一boxリンク (重力無効・地面非接触で浮遊し、WaypointMover /
    VehicleMotionController の速度コマンドで運動する)。
    通信の遮蔽OBBは model_catalog の blockage 属性で別途与えるため、
    本モデルの物理形状は通信計算に影響しない。
  </description>
</model>
